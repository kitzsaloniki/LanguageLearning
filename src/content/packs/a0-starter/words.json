  {
    "id": "hello",
    "partOfSpeech": "phrase",
    "level": "A0",
    "topicIds": ["greetings"],
    "forms": {
      "de": {
        "lemma": "hallo"
      },
      "el": {
        "lemma": "γεια σου",
        "note": {
          "de": "„Γεια σου“ sagst du zu einer Person, die du duzt. Höflich oder zu mehreren: „γεια σας“. Es heißt auch „tschüss“.",
          "el": "Το «γεια σου» το λέμε σε ένα άτομο στον ενικό. Ευγενικά ή σε πολλούς: «γεια σας». Το λέμε και όταν φεύγουμε.",
          "en": "Use “γεια σου” with one person you know well. To be polite or to greet several people, say “γεια σας”. It also means “bye”."
        }
      },
      "en": {
        "lemma": "hello"
      }
    }
  },
