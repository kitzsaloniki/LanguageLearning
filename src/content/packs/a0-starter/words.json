    "forms": {
      "de": {
        "lemma": "ja"
      },
      "el": {
        "lemma": "ναι",
        "note": {
          "de": "Vorsicht: „ναι“ klingt fast wie „nee“, heißt aber „ja“.",
          "el": "Προσοχή: το «ναι» μοιάζει με το γερμανικό «nein», αλλά σημαίνει το αντίθετο.",
          "en": "Careful: “ναι” sounds like “nay”, but it means “yes”."
        }
      },
      "en": {
        "lemma": "yes"
      }
    }
  },
