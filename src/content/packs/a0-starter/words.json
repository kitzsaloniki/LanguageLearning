  {
    "id": "please",
    "partOfSpeech": "phrase",
    "level": "A0",
    "topicIds": ["greetings"],
    "forms": {
      "de": {
        "lemma": "bitte",
        "note": {
          "de": "„Bitte“ heißt auch „gern geschehen“, als Antwort auf „danke“.",
          "el": "Το «bitte» το λέμε και ως απάντηση στο «danke», όπως το «παρακαλώ».",
          "en": "“Bitte” also means “you're welcome” as a reply to “danke”."
        }
      },
      "el": {
        "lemma": "παρακαλώ",
        "note": {
          "de": "„Παρακαλώ“ heißt auch „gern geschehen“. Viele melden sich so auch am Telefon.",
          "el": "Το «παρακαλώ» το λέμε και ως απάντηση στο «ευχαριστώ» και όταν σηκώνουμε το τηλέφωνο.",
          "en": "“Παρακαλώ” also means “you're welcome”, and many people answer the phone with it."
        }
      },
      "en": {
        "lemma": "please"
      }
    }
  },
  {
    "id": "yes",
    "partOfSpeech": "phrase",
    "level": "A0",
