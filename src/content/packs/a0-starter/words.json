  {
    "id": "i",
    "partOfSpeech": "pronoun",
    "level": "A0",
    "topicIds": ["people"],
    "forms": {
      "de": {
        "lemma": "ich"
      },
      "el": {
        "lemma": "εγώ",
        "note": {
          "de": "Im Griechischen fällt „εγώ“ meist weg, weil die Verbform die Person schon zeigt: „είμαι“ = „ich bin“.",
          "el": "Συνήθως παραλείπουμε το «εγώ», γιατί το ρήμα δείχνει ήδη το πρόσωπο: «είμαι».",
          "en": "Greek usually drops “εγώ”, because the verb already shows the person: “είμαι” = “I am”."
        }
      },
      "en": {
        "lemma": "I"
      }
    }
  },
